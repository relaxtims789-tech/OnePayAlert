# Copy to .env for local development. NEVER commit real secrets.
# APP_ENV: development | test | demo | production
APP_ENV=development
PORT=4100
DATABASE_URL=postgresql://onepay:onepay_dev_password@localhost:5433/onepay_dev?schema=public

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-dev-access-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma separated origins allowed by CORS (merchant web, admin web)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Seeded CAM super admin (development / demo only)
SEED_SUPER_ADMIN_EMAIL=admin@onepayalert.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe!Dev2026
