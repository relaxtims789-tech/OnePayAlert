# Copy to .env for local development. NEVER commit real secrets.
# APP_ENV: development | test | demo | production
APP_ENV=development
PORT=4100
DATABASE_URL=postgresql://onepay:onepay_dev_password@localhost:5433/onepay_dev?schema=public

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-dev-access-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma separated origins allowed by CORS (merchant web, admin web)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Seeded CAM super admin (development / demo only)
SEED_SUPER_ADMIN_EMAIL=admin@onepayalert.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe!Dev2026

# Public URL of this API (used to build merchant webhook URLs)
PUBLIC_API_URL=http://localhost:4100
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://onepay:onepay_dev_password@localhost:5672
# rabbitmq (default, required in production) | inline (no broker, local dev only)
QUEUE_DRIVER=rabbitmq
WORKER_ENABLED=true

# AES-256-GCM key for bank credentials / webhook secrets. DEV ONLY value below —
# demo/production refuse to start with it. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=ZGV2LW9ubHktb25lcGF5YWxlcnQta2V5LTMyLWJ5dGU=
DATA_ENCRYPTION_KEY_ID=k1

# Optional Firebase service account JSON (base64) for FCM push. Push is disabled if empty.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Merchant web app base URL (used in password reset links)
WEB_APP_URL=http://localhost:3000
# log (dev/test only) | smtp (required in demo/production)
MAIL_DRIVER=log
SMTP_URL=
MAIL_FROM=One PayAlert <no-reply@onepayalert.local>

# Billing: how merchants pay MysoftKH (shown with open invoices) and how often renewals are checked
# BILLING_PAYMENT_INSTRUCTIONS="Bank transfer to ... quoting the invoice number"
# BILLING_JOB_INTERVAL_SECONDS=900

# Soundbox broker (Phase 7). Leave MQTT_URL unset to run without soundboxes.
# MQTT_URL=mqtt://localhost:1883
# MQTT_USERNAME=onepay-api
# MQTT_PASSWORD=<at least 16 characters>
# MQTT_HOOK_SECRET=<at least 24 characters; same value as ONEPAY_MQTT_HOOK_SECRET for EMQX>

# Sign-in lockout: wrong passwords allowed per account, and how long the lock lasts (also the counting window).
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_MINUTES=15

# Bakong KHQR collection. Without a token, Bakong is simulated outside production and off in production.
# BAKONG_API_URL=https://api-bakong.nbc.gov.kh
# BAKONG_API_TOKEN=<token from api-bakong.nbc.gov.kh>
# KHQR_POLL_INTERVAL_MS=3000   # 0 turns the poller off
