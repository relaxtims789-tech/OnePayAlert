{
  "name": "@onepay/api",
  "version": "0.1.0",
  "private": true,
  "description": "One PayAlert backend REST API (NestJS + Prisma + PostgreSQL)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.js",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@expo-google-fonts/kantumruy-pro": "^0.4.1",
    "@expo-google-fonts/noto-sans-sc": "^0.4.4",
    "@nestjs/common": "11.2.9",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.9",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.9",
    "@nestjs/platform-socket.io": "^11.2.9",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "^11.2.9",
    "@node-rs/argon2": "2.2.2",
    "@onepay/shared": "0.1.0",
    "@prisma/client": "6.19.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "amqp-connection-manager": "^4.1.15",
    "amqplib": "^0.10.9",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "mqtt": "^5.16.1",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/testing": "11.2.9",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^6.0.3",
    "aedes": "^1.2.0",
    "bakong-khqr": "^1.0.20",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "socket.io-client": "^4.8.4",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  }
}
