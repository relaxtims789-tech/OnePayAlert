// One PayAlert — shared database schema for mobile, merchant web and super admin.
//
// Conventions
//  * Every identifier is a UUID.
//  * Every tenant-owned row carries `company_id` and every query MUST filter by it.
//  * Money is stored as BIGINT minor units (`*_minor`) plus an ISO-4217 currency code.
//  * Bank / gateway secrets are never stored in plain text and never returned by the API.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum CompanyStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum CompanyRole {
  OWNER
  ADMIN
  MANAGER
  ACCOUNTANT
  CASHIER
}

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum Locale {
  km
  en
  zh
}

enum Currency {
  USD
  KHR
}

enum ProviderType {
  BANK
  WALLET
  GATEWAY
}

enum BankConnectionStatus {
  PENDING
  ACTIVE
  ERROR
  DISCONNECTED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum TransactionDirection {
  CREDIT
  DEBIT
}

/// Lifecycle of a soundbox. Connectivity is tracked separately (`online`, `lastSeenAt`).
/// UNASSIGNED = in MysoftKH inventory, ACTIVE = claimed by a merchant, DISABLED = blocked by MysoftKH.
enum DeviceStatus {
  UNASSIGNED
  ACTIVE
  DISABLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
}

/// NEW = first paid period (from trial or after expiry), RENEWAL = next period of the same
/// subscription, PLAN_CHANGE = switch to another plan starting when paid.
enum InvoiceKind {
  NEW
  RENEWAL
  PLAN_CHANGE
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  OTHER
}

enum WebhookEventSource {
  WEBHOOK
  SIMULATOR
  /// Confirmed by the API polling the provider (Bakong KHQR).
  POLLER
  /// Forwarded by a merchant phone from a bank app notification (phone bank alerts).
  RELAY
}

/// How sure we are that a payment really arrived.
enum TransactionVerification {
  /// Confirmed by the bank, Bakong or a signed gateway.
  VERIFIED
  /// Read from a bank app notification on the merchant's own phone.
  REPORTED
}

/// A dynamic KHQR payment request shown to a customer at the counter.
enum KhqrChargeStatus {
  PENDING
  PAID
  EXPIRED
  CANCELED
  /// Bakong reported a payment that does not match the request (amount, currency or account).
  REVIEW
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum PushPlatform {
  ANDROID
  IOS
  WEB
}

// ───────────────────────────── Tenancy & identity ─────────────────────────────

model Company {
  id              String        @id @default(uuid()) @db.Uuid
  name            String        @db.VarChar(160)
  legalName       String?       @map("legal_name") @db.VarChar(200)
  email           String?       @db.VarChar(254)
  phone           String?       @db.VarChar(32)
  address         String?       @db.VarChar(500)
  taxId           String?       @map("tax_id") @db.VarChar(64)
  defaultCurrency Currency      @default(USD) @map("default_currency")
  status          CompanyStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  outlets         Outlet[]
  memberships     Membership[]
  bankConnections BankConnection[]
  transactions    Transaction[]
  devices         Device[]
  subscriptions   Subscription[]
  khqrCharges     KhqrCharge[]
  invoices        Invoice[]
  auditLogs       AuditLog[]

  relayPhones RelayPhone[]

  @@index([status])
  @@map("companies")
}

model Outlet {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(160)
  code      String   @db.VarChar(32)
  address   String?  @db.VarChar(500)
  phone     String?  @db.VarChar(32)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  membershipOutlets MembershipOutlet[]
  bankConnections   BankConnection[]
  transactions      Transaction[]
  devices           Device[]
  khqrCharges       KhqrCharge[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("outlets")
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(254)
  phone        String?       @db.VarChar(32)
  fullName     String        @map("full_name") @db.VarChar(160)
  passwordHash String        @map("password_hash")
  locale       Locale        @default(km)
  status       UserStatus    @default(ACTIVE)
  platformRole PlatformRole? @map("platform_role")
  lastLoginAt  DateTime?     @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships         Membership[]
  sessions            Session[]
  pushTokens          PushToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

/// A user's role inside one company. A user may belong to several companies.
model Membership {
  id        String      @id @default(uuid()) @db.Uuid
  companyId String      @map("company_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      CompanyRole
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlets MembershipOutlet[]

  @@unique([companyId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Restricts a membership to specific outlets. No rows = access to all outlets.
model MembershipOutlet {
  membershipId String @map("membership_id") @db.Uuid
  outletId     String @map("outlet_id") @db.Uuid
  companyId    String @map("company_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  outlet     Outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@id([membershipId, outletId])
  @@index([companyId])
  @@map("membership_outlets")
}

/// Refresh-token session. Only a SHA-256 hash of the refresh token is stored.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  companyId        String?   @map("company_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(128)
  userAgent        String?   @map("user_agent") @db.VarChar(400)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// Set when this session was rotated (vs. logged out); enables the reuse grace window.
  replacedById     String?   @map("replaced_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Single-use password reset token. Only a SHA-256 hash is stored.
model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)
  requestedIp String?   @map("requested_ip") @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model PushToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  token     String       @unique @db.VarChar(512)
  platform  PushPlatform
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

// ───────────────────────────── Banks & payments ─────────────────────────────

/// Platform-managed catalogue of supported banks / wallets / gateways (e.g. Bakong KHQR).
model PaymentProvider {
  id         String       @id @default(uuid()) @db.Uuid
  code       String       @unique @db.VarChar(40)
  name       String       @db.VarChar(120)
  type       ProviderType
  logoUrl    String?      @map("logo_url") @db.VarChar(500)
  /// Integration adapter used for this provider (e.g. ONEPAY_WEBHOOK_V1, SIMULATOR).
  /// NULL = no live integration yet; connections stay PENDING and cannot receive events.
  adapterKey String?      @map("adapter_key") @db.VarChar(40)
  /// Demo-only provider. Never usable when APP_ENV=production.
  isDemo     Boolean      @default(false) @map("is_demo")
  isActive   Boolean      @default(true) @map("is_active")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  connections BankConnection[]

  @@map("payment_providers")
}

/// A merchant's authorized link to a bank/gateway account.
/// `credentialCiphertext` holds envelope-encrypted secrets; it is never serialised to clients.
model BankConnection {
  id                      String               @id @default(uuid()) @db.Uuid
  companyId               String               @map("company_id") @db.Uuid
  outletId                String?              @map("outlet_id") @db.Uuid
  providerId              String               @map("provider_id") @db.Uuid
  displayName             String               @map("display_name") @db.VarChar(120)
  accountName             String?              @map("account_name") @db.VarChar(160)
  accountNumberMasked     String?              @map("account_number_masked") @db.VarChar(40)
  /// Provider account identifier that is not secret, e.g. a Bakong account ID "shop@aclb".
  externalAccountId       String?              @map("external_account_id") @db.VarChar(64)
  currency                Currency
  status                  BankConnectionStatus @default(PENDING)
  credentialCiphertext    String?              @map("credential_ciphertext")
  /// AES-256-GCM encrypted HMAC secret used to verify inbound webhooks.
  webhookSecretCiphertext String?              @map("webhook_secret_ciphertext")
  lastSyncedAt            DateTime?            @map("last_synced_at") @db.Timestamptz(6)
  lastError               String?              @map("last_error") @db.VarChar(500)
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  outlet        Outlet?         @relation(fields: [outletId], references: [id], onDelete: SetNull)
  provider      PaymentProvider @relation(fields: [providerId], references: [id])
  transactions  Transaction[]
  webhookEvents WebhookEvent[]
  khqrCharges   KhqrCharge[]

  relayPhones RelayPhone[]

  @@index([companyId])
  @@index([providerId])
  @@map("bank_connections")
}

model Transaction {
  id                 String                  @id @default(uuid()) @db.Uuid
  companyId          String                  @map("company_id") @db.Uuid
  outletId           String?                 @map("outlet_id") @db.Uuid
  bankConnectionId   String                  @map("bank_connection_id") @db.Uuid
  providerTxnId      String                  @map("provider_txn_id") @db.VarChar(128)
  direction          TransactionDirection    @default(CREDIT)
  status             TransactionStatus
  amountMinor        BigInt                  @map("amount_minor")
  currency           Currency
  payerName          String?                 @map("payer_name") @db.VarChar(160)
  payerAccountMasked String?                 @map("payer_account_masked") @db.VarChar(40)
  reference          String?                 @db.VarChar(160)
  description        String?                 @db.VarChar(500)
  occurredAt         DateTime                @map("occurred_at") @db.Timestamptz(6)
  receivedAt         DateTime                @default(now()) @map("received_at") @db.Timestamptz(6)
  /// Provider payload kept for reconciliation (secrets stripped before storing).
  rawPayload         Json?                   @map("raw_payload")
  /// True only for demo simulator payments. Always false in production.
  isSimulated        Boolean                 @default(false) @map("is_simulated")
  verification       TransactionVerification @default(VERIFIED)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  outlet         Outlet?        @relation(fields: [outletId], references: [id], onDelete: SetNull)
  bankConnection BankConnection @relation(fields: [bankConnectionId], references: [id])

  /// Idempotency: a provider event is stored once per connection.
  @@unique([bankConnectionId, providerTxnId])
  @@index([companyId, occurredAt(sort: Desc)])
  @@index([companyId, outletId, occurredAt(sort: Desc)])
  @@index([companyId, status])
  @@map("transactions")
}

/// Inbox of every inbound provider event. The DB row is the source of truth; the queue
/// message only carries its id, so lost messages are recovered by the re-publish sweeper.
model WebhookEvent {
  id               String             @id @default(uuid()) @db.Uuid
  companyId        String             @map("company_id") @db.Uuid
  bankConnectionId String             @map("bank_connection_id") @db.Uuid
  providerEventId  String             @map("provider_event_id") @db.VarChar(128)
  source           WebhookEventSource
  status           WebhookEventStatus @default(RECEIVED)
  attempts         Int                @default(0)
  lastError        String?            @map("last_error") @db.VarChar(500)
  payload          Json
  transactionId    String?            @map("transaction_id") @db.Uuid
  receivedAt       DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt      DateTime?          @map("processed_at") @db.Timestamptz(6)

  bankConnection BankConnection @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)

  @@unique([bankConnectionId, providerEventId])
  @@index([status, receivedAt])
  @@index([companyId, receivedAt(sort: Desc)])
  @@map("webhook_events")
}

// ───────────────────────────── Soundbox devices ─────────────────────────────

/// A payment soundbox. Connects to EMQX with username = client id = serial number and a per-device
/// password; EMQX asks the API (HTTP auth/ACL hooks) whether to let it in and what it may touch.
model Device {
  id               String       @id @default(uuid()) @db.Uuid
  companyId        String?      @map("company_id") @db.Uuid
  outletId         String?      @map("outlet_id") @db.Uuid
  serialNumber     String       @unique @map("serial_number") @db.VarChar(64)
  model            String       @db.VarChar(64)
  /// Merchant's label, e.g. "Front counter".
  name             String?      @db.VarChar(80)
  firmware         String?      @db.VarChar(32)
  /// Argon2 hash of the device's MQTT password (shown once, flashed onto the device).
  secretHash       String       @map("secret_hash")
  /// Argon2 hash of the claim code printed on the box (lets a merchant prove they hold the device).
  claimCodeHash    String       @map("claim_code_hash")
  status           DeviceStatus @default(UNASSIGNED)
  /// Announcement language and volume (0-100).
  locale           Locale       @default(km)
  volume           Int          @default(80)
  /// Speak payments read from a phone bank alert (not confirmed by the bank).
  announceReported Boolean      @default(true) @map("announce_reported")
  online           Boolean      @default(false)
  lastSeenAt       DateTime?    @map("last_seen_at") @db.Timestamptz(6)
  batteryPct       Int?         @map("battery_pct")
  signalDbm        Int?         @map("signal_dbm")
  claimedAt        DateTime?    @map("claimed_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  outlet  Outlet?  @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, outletId])
  @@map("devices")
}

// ───────────────────────────── Subscriptions ─────────────────────────────

model Plan {
  id           String          @id @default(uuid()) @db.Uuid
  code         String          @unique @db.VarChar(40)
  name         String          @db.VarChar(120)
  priceMinor   BigInt          @map("price_minor")
  currency     Currency        @default(USD)
  interval     BillingInterval @default(MONTH)
  maxOutlets   Int             @map("max_outlets")
  maxEmployees Int             @map("max_employees")
  maxBankConns Int             @map("max_bank_connections")
  maxDevices   Int             @map("max_devices")
  isActive     Boolean         @default(true) @map("is_active")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions Subscription[]
  invoices      Invoice[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String             @map("company_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus
  currentPeriodStart DateTime           @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Timestamptz(6)
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  canceledAt         DateTime?          @map("canceled_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([companyId, status])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

/// A bill from MysoftKH to a merchant. Paid invoices are confirmed by MysoftKH staff after the
/// money has actually arrived (bank transfer or cash) — nothing marks an invoice paid on its own.
model Invoice {
  id               String          @id @default(uuid()) @db.Uuid
  /// Human-readable, unique and sequential: INV-2026-000123.
  number           String          @unique @db.VarChar(32)
  companyId        String          @map("company_id") @db.Uuid
  subscriptionId   String          @map("subscription_id") @db.Uuid
  planId           String          @map("plan_id") @db.Uuid
  kind             InvoiceKind
  status           InvoiceStatus   @default(OPEN)
  /// Snapshot of the plan price when the invoice was issued.
  amountMinor      BigInt          @map("amount_minor")
  currency         Currency
  interval         BillingInterval
  dueAt            DateTime        @map("due_at") @db.Timestamptz(6)
  /// The service period this payment bought; set when the invoice is paid.
  periodStart      DateTime?       @map("period_start") @db.Timestamptz(6)
  periodEnd        DateTime?       @map("period_end") @db.Timestamptz(6)
  paidAt           DateTime?       @map("paid_at") @db.Timestamptz(6)
  paymentMethod    PaymentMethod?  @map("payment_method")
  paymentReference String?         @map("payment_reference") @db.VarChar(120)
  /// MysoftKH staff member who confirmed the payment.
  confirmedById    String?         @map("confirmed_by_id") @db.Uuid
  voidedAt         DateTime?       @map("voided_at") @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([companyId, createdAt(sort: Desc)])
  @@index([status, dueAt])
  @@map("invoices")
}

// ───────────────────────────── Audit ─────────────────────────────

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String?  @map("company_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(80)
  entityType  String   @map("entity_type") @db.VarChar(60)
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([actorUserId])
  @@map("audit_logs")
}

/// A one-off KHQR code for a given amount. Bakong is polled by its MD5 until it is paid or expires;
/// the payment then enters the normal ingestion pipeline (alerts, reports).
model KhqrCharge {
  id               String           @id @default(uuid()) @db.Uuid
  companyId        String           @map("company_id") @db.Uuid
  bankConnectionId String           @map("bank_connection_id") @db.Uuid
  outletId         String?          @map("outlet_id") @db.Uuid
  createdById      String?          @map("created_by_id") @db.Uuid
  /// Short reference printed in the QR (bill number) and on receipts.
  reference        String           @db.VarChar(25)
  amountMinor      BigInt           @map("amount_minor")
  currency         Currency
  qr               String
  md5              String           @unique @db.Char(32)
  status           KhqrChargeStatus @default(PENDING)
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(6)
  paidAt           DateTime?        @map("paid_at") @db.Timestamptz(6)
  /// Bakong transaction hash, once paid.
  providerTxnId    String?          @map("provider_txn_id") @db.VarChar(128)
  payerAccount     String?          @map("payer_account") @db.VarChar(64)
  reviewReason     String?          @map("review_reason") @db.VarChar(300)
  simulated        Boolean          @default(false)
  lastCheckedAt    DateTime?        @map("last_checked_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankConnection BankConnection @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)
  outlet         Outlet?        @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("khqr_charges")
}

/// A merchant phone that forwards bank app notifications ("phone bank alerts").
model RelayPhone {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  bankConnectionId String    @map("bank_connection_id") @db.Uuid
  name             String    @db.VarChar(80)
  /// AES-GCM. The phone signs every request with it (HMAC-SHA256, as the signed webhook does).
  secretCiphertext String    @map("secret_ciphertext")
  createdById      String?   @map("created_by_id") @db.Uuid
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz(6)
  lastPaymentAt    DateTime? @map("last_payment_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankConnection BankConnection @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([bankConnectionId])
  @@map("relay_phones")
}
