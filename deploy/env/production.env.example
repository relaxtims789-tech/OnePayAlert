# One PayAlert — PRODUCTION environment. Copy to production.env (never commit it) and fill in.
# Generate secrets with:  openssl rand -base64 48   (DATA_ENCRYPTION_KEY: openssl rand -base64 32)
# Every value here must differ from the demo environment.

APP_ENV=production
IMAGE_PREFIX=onepay
IMAGE_TAG=latest

# Public names (DNS A/AAAA records pointing at this host). Caddy obtains certificates for them.
APP_DOMAIN=app.onepayalert.com
ADMIN_DOMAIN=admin.onepayalert.com
API_DOMAIN=api.onepayalert.com
ACME_EMAIL=ops@example.com
# MysoftKH console reachable only from these addresses (office / VPN). Space separated CIDRs.
ADMIN_ALLOWED_IPS=203.0.113.10/32

# Database: the owner runs migrations; the API runs as onepay_app (row-level security applies).
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=

JWT_ACCESS_SECRET=
# 32 random bytes, base64. Encrypts bank credentials and webhook secrets. Losing it loses them.
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=k1

SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=One PayAlert <no-reply@onepayalert.com>

# Optional: Firebase service account JSON, base64. Without it, closed-app push is off.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Shown to merchants with every unpaid invoice.
BILLING_PAYMENT_INSTRUCTIONS=Pay by bank transfer to Mysoftkh, ABA account 000 000 000, quoting the invoice number.

# Optional: Prometheus scraping of http://api:4100/api/v1/metrics from inside the network.
METRICS_TOKEN=

# Optional soundboxes (start with --profile soundbox). Certificates for the MQTT host in deploy/certs/mqtt/.
MQTT_URL=mqtt://emqx:1883
MQTT_PASSWORD=
MQTT_HOOK_SECRET=
EMQX_DASHBOARD_PASSWORD=

# Bakong KHQR collection. Get a token at https://api-bakong.nbc.gov.kh (it expires; renew it before then).
# Without a token, KHQR collection is switched off in production; payments are never simulated here.
BAKONG_API_TOKEN=
# BAKONG_API_URL=https://api-bakong.nbc.gov.kh
# KHQR_POLL_INTERVAL_MS=3000

BACKUP_DIR=./backups
