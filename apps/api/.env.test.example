# Used by `npm run test:e2e`. Points at a dedicated, disposable test database.
APP_ENV=test
PORT=4101
# Owner connection: migrations and seed (tables belong to this role).
MIGRATION_DATABASE_URL=postgresql://onepay:onepay_dev_password@localhost:5433/onepay_test?schema=public
# Runtime connection: a plain role, so row-level security applies (created by prisma/app-role.mjs).
DATABASE_URL=postgresql://onepay_app_test:test-only-app-role-password@localhost:5433/onepay_test?schema=public
JWT_ACCESS_SECRET=test-access-secret-at-least-32-characters-long
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:3100
PUBLIC_API_URL=http://localhost:4101
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://onepay:onepay_dev_password@localhost:5672
QUEUE_DRIVER=rabbitmq
WORKER_ENABLED=true
DATA_ENCRYPTION_KEY=ZGV2LW9ubHktb25lcGF5YWxlcnQta2V5LTMyLWJ5dGU=
DATA_ENCRYPTION_KEY_ID=k1
WEB_APP_URL=http://localhost:3100
MAIL_DRIVER=log

# Billing lifecycle job: tests trigger it directly
BILLING_JOB_INTERVAL_SECONDS=0

# Soundbox hooks (tests use an in-process broker, so no MQTT_URL)
MQTT_PASSWORD=test-only-mqtt-api-password
MQTT_HOOK_SECRET=test-only-mqtt-hook-secret-0123456789

# Metrics endpoint (tests check it is protected)
METRICS_TOKEN=test-only-metrics-token-0123456789

# KHQR: tests poll directly (no timer); Bakong is simulated (no token)
KHQR_POLL_INTERVAL_MS=0
